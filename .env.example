# Copy to .env and fill in. .env is gitignored — never commit real secrets.

# Bubble bot token (apply for one via the Bubble / PixelMug developer program).
BOT_TOKEN=

# Dexcom Share follower credentials. Leave DEXCOM_USERNAME blank to run on
# synthetic demo data instead of live glucose.
DEXCOM_USERNAME=
DEXCOM_PASSWORD=
DEXCOM_REGION=eu          # eu (shareous1) or us

# Public base URL that serves ./out. The mug downloads the GIF from here, so it
# MUST be reachable from the internet (bucket, static host, or a tunnel to this box).
# e.g. https://muggen.example.com
GIF_PUBLIC_BASE_URL=

# Push cadence in ms (default 5 min = 300000).
INTERVAL_MS=300000

# Warning thresholds (mmol) and how far ahead to predict (minutes).
LOW_URGENT=3.0
HIGH_URGENT=14.0
PRED_WINDOW_MIN=20

# Face pack: a folder of six 32x16 GIFs (happy/worried/panic/queasy/sick/sleep.gif)
# to use instead of the built-in NOT-man faces. Leave blank for built-in.
# See "Making a face pack" in the README.  e.g. FACE_PACK=my-theme
FACE_PACK=
