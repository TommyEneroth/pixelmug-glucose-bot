{
  "name": "pixelmug-glucose-bot",
  "version": "0.1.0",
  "description": "Turn a PixelMug P1 into a live blood-glucose VU-meter (Dexcom Share -> 32x16 GIF -> Bubble bot).",
  "type": "module",
  "scripts": {
    "setup": "bash scripts/fetch-sdk.sh",
    "dryrun": "bun run src/dryrun.ts",
    "serve": "bun run src/serve.ts",
    "bot": "bun run src/glucoseBot.ts",
    "export-faces": "bun run src/export-faces.ts",
    "gen-snobben": "bun run src/gen-snobben.ts",
    "gen-emoji": "bun run src/gen-emoji.ts",
    "gen-pacman": "bun run src/gen-pacman.ts",
    "gen-mumin": "bun run src/gen-mumin.ts",
    "gen-weather": "bun run src/gen-weather.ts",
    "gen-fire": "bun run src/gen-fire.ts",
    "gen-aqua": "bun run src/gen-aqua.ts",
    "gen-lava": "bun run src/gen-lava.ts",
    "gen-matrix": "bun run src/gen-matrix.ts",
    "gen-space": "bun run src/gen-space.ts",
    "gen-synth": "bun run src/gen-synth.ts",
    "test": "bun test"
  },
  "dependencies": {
    "gifenc": "^1.0.3"
  },
  "devDependencies": {
    "@types/bun": "latest"
  }
}
